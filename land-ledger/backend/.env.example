# LAND LEDGER backend - environment configuration example
# Copy the values you need into backend/.env (gitignored) - NEVER commit real secrets.

# ---------- Core ----------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---------- MongoDB Atlas (primary database) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.kbwpfqx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=land_ledger

# ---------- Auth ----------
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# ---------- Email OTP MFA (Part 5 of the MFA spec) ----------
# Any SMTP provider works. For Gmail: enable 2-Step Verification, then create
# an APP PASSWORD (Google Account > Security > App passwords) - never use the
# account's real password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=LAND LEDGER <your.sender@gmail.com>

# OTP verification codes are emailed to the allowlisted addresses when SMTP is
# configured. Without SMTP the login OTP step FAILS SAFELY (503) - MFA is
# never bypassed silently.

# ---------- DEMO-ONLY (remove in production) ----------
# When MFA_DEV_MODE=1 AND NODE_ENV=development AND SMTP is NOT configured,
# the OTP is surfaced in the login response (devCode) so the demo can run
# without a mailbox. This triple gate can never open in production.
# MFA_DEV_MODE=1

# Tuning (defaults shown)
# MFA_OTP_TTL_MINUTES=5
# MFA_OTP_MAX_ATTEMPTS=5
# MFA_RESEND_COOLDOWN_SECONDS=45
# MFA_MAX_SENDS_PER_CHALLENGE=3
# MFA_MAX_CHALLENGES_PER_HOUR=5

# ---------- Blockchain (local Hardhat) ----------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK_NAME=hardhat
# CONTRACT_ADDRESS is written automatically to deployments/local.json at deploy time.
