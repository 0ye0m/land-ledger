# ============================================================
# LAND LEDGER - Environment configuration
# Copy this file to .env (root) and adjust per environment.
# NEVER commit real secrets. Never hardcode credentials in code.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---- Database: MongoDB Atlas (primary, required) ----
# Free M0 cluster is fine: https://www.mongodb.com/cloud/atlas/register
# Network Access must allow your server IP. Leave URI empty only for offline dev.
MONGODB_URI=
MONGODB_DB_NAME=land_ledger

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOC_EXTENSIONS=pdf,png,jpg,jpeg,webp,doc,docx

# ---- Blockchain (Hardhat local network) ----
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Operator account that signs registry transactions (Hardhat account #0 by default).
# NEVER use a funded mainnet key here. Override per environment.
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Set after running: cd blockchain && npx hardhat run scripts/deploy.js
CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK_NAME=hardhat

# ---- Seed (development/demo only) ----
SEED_REGISTRAR_EMAIL=meera.krishnan@landledger.gov
SEED_REGISTRAR_PASSWORD=Registrar@123
SEED_CITIZEN_EMAIL=asha.rao@example.com
SEED_CITIZEN_PASSWORD=Citizen@123

# ---- MongoDB Atlas (free M0 tier - optional) ----
# Atlas event store for audit mirror + login security telemetry.
# Leave empty to run PostgreSQL-only. Format:
# mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=land_ledger
MONGODB_SERVER_SELECTION_MS=8000
MONGODB_MAX_POOL_SIZE=10
